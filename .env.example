# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Safe in the browser. RLS applies to everything it does.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon / publishable key>"

# BYPASSES EVERY RLS POLICY. Server-only. Never NEXT_PUBLIC_, never committed,
# never pasted into a chat window. Rotate it if it is ever exposed.
SUPABASE_SERVICE_ROLE_KEY="<service role key>"

# ---------------------------------------------------------------------------
# n8n EOD form
# ---------------------------------------------------------------------------
# The form the EOD Report tab embeds.
N8N_EOD_FORM_URL="https://n8n.your-domain.com/form/<form-id>"

# n8n's Form Trigger prefills a field by matching a query parameter to that
# field's LABEL. Set each of these to the exact label used in your form.
# Defaults below are used if you leave them unset.
N8N_EOD_PARAM_USER_ID="user_id"
N8N_EOD_PARAM_NAME="name"
N8N_EOD_PARAM_EMAIL="email"
N8N_EOD_PARAM_DATE="date"
N8N_EOD_PARAM_TOKEN="token"

# Shared secret for the return webhook. Generate with:
#   openssl rand -base64 32
# Also used to sign the per-user EOD attribution token.
N8N_WEBHOOK_SECRET="<generate one>"

# ---------------------------------------------------------------------------
# Shared tool credentials (Team assets)
# ---------------------------------------------------------------------------
# AES-256-GCM key for public.credentials. Generate with:
#   openssl rand -base64 32
# Deliberately not stored in Postgres, so a database dump yields only
# ciphertext. Lose it and stored passwords are unrecoverable; change it and
# every existing credential must be re-entered.
CREDENTIALS_ENCRYPTION_KEY="<generate one>"

# ---------------------------------------------------------------------------
# Seed script (local only — never set these in production)
# ---------------------------------------------------------------------------
SEED_OWNER_EMAIL="owner@sysorastack.com"
SEED_OWNER_PASSWORD="<pick one>"
# Shared password for the three non-owner demo accounts. Required by npm run seed.
SEED_DEMO_PASSWORD="<pick one>"
